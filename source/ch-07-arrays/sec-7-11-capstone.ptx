490 681
475 681
475 694]]></program>

    <p>
      Your program will insert the name and the points into the HTML:
    </p>

    <program language="html"><![CDATA[<title>Black Heritage Trail</title>
<h1>Black Heritage Trail</h1>]]></program>

    <p>
      And:
    </p>

    <program language="javascript"><![CDATA[const points = [
{x: 526.0, y: 780.0},
{x: 525.0, y: 772.0},
{x: 488.0, y: 790.0},
{x: 488.0, y: 725.0},
{x: 346.0, y: 725.0},
{x: 346.0, y: 742.0},
{x: 323.0, y: 742.0},
{x: 323.0, y: 767.0},
{x: 323.0, y: 706.0},
{x: 350.0, y: 706.0},
{x: 350.0, y: 676.0},
{x: 452.0, y: 675.0},
{x: 452.0, y: 646.0},
{x: 490.0, y: 646.0},
{x: 490.0, y: 681.0},
